# Required — your Anthropic API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key isn't scoped to a workspace (e.g. keys starting with sk-ant-usr-).
# Find it in console.anthropic.com → Settings → Workspaces (looks like wrkspc_...).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional — which Claude model coaches. Haiku is fastest/cheapest; Sonnet gives richer advice.
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_MODEL=claude-sonnet-5-5
